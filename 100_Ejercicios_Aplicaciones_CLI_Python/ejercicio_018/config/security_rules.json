[
  {
    "name": "JWT_TOKEN",
    "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
    "mask": "[REDACTED-JWT]"
  },
  {
    "name": "API_KEY",
    "pattern": "sk_[a-zA-Z0-9]{24,}",
    "mask": "[REDACTED-KEY]"
  },
  {
    "name": "BEARER_AUTH",
    "pattern": "Bearer\\s+[A-Za-z0-9_.-]+",
    "mask": "Bearer [REDACTED]"
  }
]